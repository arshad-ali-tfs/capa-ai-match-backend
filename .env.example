CAPA_ENV=local
# Optional override for installed-wheel launch/configuration directory.
CAPA_PROJECT_ROOT=
CAPA_DATA_DIR=./data
CAPA_CACHE_DIR=./data/cache
CAPA_SOURCE_SNAPSHOT=./data/sources/REPLACE_WITH_SNAPSHOT_ID.sqlite3
CAPA_SOURCE_CSV=./data/sources/trackwise_records.csv
CAPA_ALLOWED_ORIGINS_JSON=["http://localhost:8100","http://127.0.0.1:8100","http://localhost:5173","http://127.0.0.1:5173"]
MATCH_INDEX_DIR=./data/match-index
MATCH_MODEL_CACHE=./data/models/huggingface
MATCH_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# Explicitly list indexed sites this service may search; index build fills this value.
MATCH_ALLOWED_SITES_JSON=[]
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MATCH_HOST=127.0.0.1
MATCH_PORT=8102
