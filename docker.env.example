# Copy to .env.docker; Docker env files use plain KEY=value, without shell quotes.
# All paths are Linux paths INSIDE the container, not Windows host paths.
CAPA_ENV=local
CAPA_PROJECT_ROOT=/app
CAPA_DATA_DIR=/data
CAPA_CACHE_DIR=/data/cache
# Run-Match.ps1 imports the source and fills these paths automatically.
CAPA_SOURCE_SNAPSHOT=
CAPA_SOURCE_CSV=/data/sources/trackwise_records.csv
MATCH_HOST=0.0.0.0
MATCH_PORT=8102
CAPA_ALLOWED_ORIGINS_JSON=["http://localhost:8100","http://127.0.0.1:8100","http://localhost:5173","http://127.0.0.1:5173"]
# Run-Match.ps1 activates a versioned Linux index under /data/match-managed/.
MATCH_INDEX_DIR=
MATCH_MODEL_CACHE=/data/models/huggingface
MATCH_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# Local setup: auto uses all indexed sites. An explicit JSON array restricts it.
# [] deliberately denies access; the launcher will request a usable site list.
MATCH_ALLOWED_SITES_JSON=auto
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
